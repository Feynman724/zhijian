page{background:#e9e8e2;color:#18211e;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}
button{margin:0;padding:0;font-size:26rpx;line-height:1.2;border-radius:16rpx}button::after{border:none}
.app{min-height:100vh;padding-bottom:calc(70rpx + env(safe-area-inset-bottom))}
.heading{height:102rpx;padding:0 34rpx;display:flex;align-items:center;justify-content:space-between;background:#fbfaf7;border-bottom:1rpx solid #d8ddd8}
.brand{display:flex;align-items:center;gap:16rpx}.brand-mark{width:52rpx;height:52rpx;border:2rpx solid #284c43;border-radius:14rpx;display:flex;align-items:center;justify-content:center;gap:5rpx}.brand-mark view{width:5rpx;border-radius:4rpx;background:#284c43}.brand-mark view:nth-child(1){height:18rpx}.brand-mark view:nth-child(2){height:30rpx}.brand-mark view:nth-child(3){height:22rpx}.brand-name,.brand-caption{display:block}.brand-name{font-size:34rpx;font-weight:700;letter-spacing:2rpx}.brand-caption{font-size:18rpx;color:#65706b}.header-action{padding:15rpx 22rpx;background:#e4ece8;color:#284c43;font-weight:650}
.workspace-card{margin:24rpx 28rpx 0;padding:28rpx 30rpx 26rpx;background:#284c43;color:#fff;border-radius:28rpx;box-shadow:0 14rpx 34rpx rgba(23,58,51,.12)}.workspace-label{font-size:20rpx;letter-spacing:3rpx;color:#c8dbd2}.workspace-title{margin-top:16rpx;font-size:38rpx;font-weight:700}.workspace-question{margin-top:7rpx;font-size:24rpx;color:#d9e6e0;line-height:1.55}.members{margin-top:22rpx;display:flex;align-items:center;font-size:20rpx;color:#d9e6e0}.member{width:34rpx;height:34rpx;line-height:34rpx;border-radius:50%;background:#dce9e1;color:#284c43;text-align:center;font-size:18rpx;margin-right:-7rpx;border:2rpx solid #284c43}.member.bronze{background:#d7bda6;color:#583a20}.member.slate{background:#c4d0d3;color:#30464c;margin-right:18rpx}
.tabbar{margin:26rpx 28rpx 0;display:flex;gap:8rpx;padding:7rpx;background:#dcded9;border-radius:18rpx}.tab{min-width:0;flex:1;padding:16rpx 8rpx;text-align:center;color:#65706b;font-size:25rpx;border-radius:13rpx}.tab text{margin-left:7rpx;font-size:20rpx;color:#84918a}.tab.selected{background:#fbfaf7;color:#284c43;font-weight:700;box-shadow:0 3rpx 10rpx rgba(20,44,34,.07)}.tab.selected text{color:#284c43}
.section{margin:22rpx 28rpx 0}.section-head{display:flex;justify-content:space-between;align-items:end;margin:0 3rpx 21rpx}.eyebrow{display:block;color:#284c43;font-size:18rpx;font-weight:800;letter-spacing:2.6rpx}.section-title{display:block;margin-top:7rpx;font-size:30rpx;font-weight:700}.section-count{color:#65706b;font-size:22rpx}.source-hint{display:flex;align-items:center;gap:8rpx;color:#65706b;font-size:20rpx;margin:0 3rpx 22rpx}.dot{width:10rpx;height:10rpx;border-radius:50%;display:inline-block;margin-left:15rpx}.dot:first-child{margin-left:0}.dot.chat{background:#284c43}.dot.meeting{background:#766b83}.dot.file{background:#8a6033}.dot.bot{background:#527864}
.timeline{border-left:2rpx solid #cbd5ce;margin-left:74rpx}.event{display:flex;position:relative;margin:0 0 17rpx -74rpx;gap:16rpx}.event-rail{width:73rpx;flex:none;position:relative;text-align:left}.event-time{display:block;padding-top:24rpx;color:#65706b;font-size:20rpx}.rail-dot{position:absolute;top:30rpx;right:-7rpx;width:14rpx;height:14rpx;border-radius:50%;background:#284c43;border:4rpx solid #e9e8e2}.rail-dot.meeting{background:#766b83}.rail-dot.file{background:#8a6033}.rail-dot.bot{background:#527864}.event-card{min-width:0;flex:1;background:#fbfaf7;border:1rpx solid #d9ddd8;border-radius:20rpx;padding:22rpx 23rpx}.event-meeting .event-card{background:#f7f4f8;border-color:#d8d1dc}.event-bot .event-card{background:#edf4ef;border-color:#c2d6c9}.event-top{display:flex;align-items:center;gap:12rpx}.avatar{flex:none;width:44rpx;height:44rpx;line-height:44rpx;text-align:center;background:#e4ece8;color:#284c43;font-size:20rpx;border-radius:12rpx;font-weight:700}.avatar.purple{background:#e9e3ee;color:#766b83}.avatar.dark{background:#284c43;color:#fff}.event-author text{display:block;font-size:23rpx;font-weight:650}.event-author .event-source{margin-top:2rpx;color:#79837d;font-size:18rpx;font-weight:400}.event-title{margin-top:15rpx;font-weight:700;font-size:26rpx}.event-body{margin-top:6rpx;line-height:1.65;font-size:24rpx;color:#3a4841;word-break:break-all}.event-analysis{margin-top:15rpx;padding:14rpx 16rpx;border-radius:10rpx;background:#e4ece8;color:#315b4c;font-size:21rpx;line-height:1.5}.event-analysis text{display:block}.analysis-kicker{font-size:17rpx;font-weight:800;letter-spacing:2rpx;margin-bottom:4rpx}
.composer{margin:24rpx 0 0;background:#fbfaf7;border:1rpx solid #d5dcd6;border-radius:20rpx;padding:17rpx}.composer input{height:78rpx;padding:0 10rpx;font-size:25rpx}.composer-actions{display:flex;gap:12rpx;align-items:center}.tool-button,.send-button{padding:15rpx 19rpx}.tool-button{color:#284c43;background:#e4ece8}.send-button{margin-left:auto;color:#fff;background:#284c43;padding-left:28rpx;padding-right:28rpx}
.purple-text{color:#766b83}.meeting-banner{display:flex;gap:17rpx;align-items:center;padding:25rpx;background:#fbfaf7;border-radius:20rpx;border:1rpx solid #d8d1dc}.meeting-symbol{width:70rpx;height:70rpx;display:grid;place-items:center;border-radius:16rpx;background:#e9e3ee;color:#766b83;font-weight:700}.meeting-title,.meeting-subtitle{display:block}.meeting-title{font-size:29rpx;font-weight:700}.meeting-subtitle{margin-top:5rpx;font-size:21rpx;color:#65706b}.meeting-note{margin:16rpx 0 22rpx;color:#65706b;line-height:1.6;font-size:23rpx}.meeting-row{margin-bottom:13rpx;padding:22rpx 24rpx;border-radius:18rpx;background:#fbfaf7;border-left:5rpx solid #766b83}.meeting-row-head{display:flex;justify-content:space-between;color:#766b83;font-size:20rpx}.meeting-row-title{margin-top:9rpx;font-size:26rpx;font-weight:700}.meeting-row-body{margin-top:6rpx;color:#435149;font-size:24rpx;line-height:1.6}.meeting-actions{display:flex;gap:12rpx;margin-top:24rpx}.meeting-actions button{flex:1;min-height:76rpx}.primary{background:#284c43;color:#fff;padding:19rpx}.outline{background:#fbfaf7;color:#284c43;border:1rpx solid #9db4a8;padding:19rpx}.meeting-input{margin-top:16rpx;padding:16rpx;background:#fbfaf7;border-radius:18rpx}.meeting-input textarea{min-height:130rpx;width:100%;font-size:24rpx;line-height:1.5}.meeting-input button{margin-top:12rpx;background:#284c43;color:#fff;padding:22rpx}
.decision-card{padding:28rpx;background:#fbfaf7;border:1rpx solid #d5dcd6;border-radius:24rpx}.decision-top{display:flex;justify-content:space-between;align-items:center;color:#284c43;font-size:22rpx;font-weight:800;letter-spacing:1rpx}.confirmed{background:#e4ece8;padding:8rpx 13rpx;border-radius:30rpx;font-size:19rpx}.decision-title{margin-top:23rpx;font-size:33rpx;font-weight:700;line-height:1.45}.decision-grid{display:flex;gap:13rpx;margin-top:24rpx}.decision-grid view{flex:1;background:#f0f1ed;border-radius:14rpx;padding:15rpx}.decision-grid text{display:block}.decision-grid text:first-child{font-size:19rpx;color:#65706b}.decision-grid text:last-child{margin-top:5rpx;font-size:24rpx;font-weight:650}.decision-block{border-top:1rpx solid #e1e4df;margin-top:24rpx;padding-top:23rpx}.block-label{display:block;color:#65706b;font-size:21rpx;font-weight:700;margin-bottom:12rpx}.evidence{display:flex;gap:13rpx;line-height:1.5;margin-top:10rpx;font-size:23rpx}.evidence text:first-child{color:#284c43;font-weight:800}.decision-copy{color:#374a40;font-size:23rpx;line-height:1.6}.decision-footer{margin-top:24rpx;color:#65706b;font-size:21rpx}.full{width:100%;margin-top:20rpx}.bottom-note{text-align:center;margin:35rpx 0 0;color:#87918a;font-size:20rpx}.bottom-note text{color:#284c43;text-decoration:underline}
.modal-backdrop{position:fixed;inset:0;background:rgba(18,33,29,.58);z-index:10;display:flex;align-items:end}.export-sheet{width:100%;max-height:89vh;display:flex;flex-direction:column;background:#fbfaf7;border-radius:32rpx 32rpx 0 0;padding:0 28rpx calc(22rpx + env(safe-area-inset-bottom));box-sizing:border-box}.sheet-grip{height:8rpx;width:76rpx;border-radius:99rpx;background:#c9d0ca;margin:15rpx auto 24rpx}.sheet-heading{display:flex;justify-content:space-between;align-items:start}.sheet-title{display:block;margin-top:6rpx;font-size:34rpx;font-weight:700}.sheet-close{font-size:45rpx;line-height:1;color:#65706b;padding:0 8rpx}.sheet-description{margin-top:17rpx;font-size:23rpx;color:#65706b;line-height:1.6}.format-switch{display:flex;gap:8rpx;padding:6rpx;border-radius:14rpx;background:#e9e8e2;margin:20rpx 0}.format-switch view{flex:1;text-align:center;padding:13rpx;border-radius:10rpx;color:#65706b;font-size:23rpx}.format-switch .active{background:#fff;color:#284c43;font-weight:700}.preview{height:43vh;background:#f1f3ef;border:1rpx solid #dce3dc;border-radius:12rpx;box-sizing:border-box;padding:18rpx}.preview text{font-family:monospace;font-size:21rpx;line-height:1.6;white-space:pre-wrap;word-break:break-all;color:#2d3d34}.sheet-actions{display:flex;gap:12rpx;margin-top:18rpx}.sheet-actions button{flex:1;min-height:80rpx}
.demo-notice{padding:14rpx 16rpx;margin:-6rpx 0 22rpx;background:#f4eee5;color:#775c3c;border-radius:12rpx;font-size:20rpx;line-height:1.5}
